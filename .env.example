# Variables de entorno para correr fuera de la máquina local (VPS).
# Copiar a .env (o al EnvironmentFile del servicio) y completar. Nunca commitear valores reales.
APP_BASE_URL=https://paradigmas6.agustingimenez.ar

# Cliente OAuth de Google (Google Cloud Console > APIs y servicios > Credenciales > ID de cliente
# de OAuth, tipo "Aplicación web"). URI de redireccionamiento autorizado:
#   {APP_BASE_URL}/login/oauth2/code/google   (en local: http://localhost:8080/login/oauth2/code/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Detrás del proxy HTTPS: confiar en X-Forwarded-Proto para que la cookie de sesión salga Secure.
SERVER_FORWARD_HEADERS_STRATEGY=native

# La consola JPQL expone toda la base: apagada en el VPS.
HQL_CONSOLE_ENABLED=false

# Opcionales (valores por defecto): vigencia de cada QR de ingreso, duración de la sesión de una
# computadora, aviso para extenderla y tiempo que queda reservado el nombre anterior al cambiarlo.
# APP_LOGIN_TTL=60s
# APP_SESSION_DESKTOP_TTL=30m
# APP_SESSION_WARNING=2m
# APP_USER_RENAME_GRACE=10m
